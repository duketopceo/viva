# Model access for the tutor — explanations are labeled "inferred", never evidence.
OPENROUTER_API_KEY=

# Optional: DeepTutor connector (evaluated in U10 — not required for core)
# DEEPTUTOR_CMD=
# DEEPTUTOR_REPO=

# Local data roots (defaults shown; override for tests)
# VIVA_DATA_DIR=~/.local/share/viva
# VIVA_INDEX_DIR=~/.local/share/viva/index
# VIVA_ARTIFACT_DIR=~/.local/share/viva/artifacts

# First language ecosystem (tree-sitter based; default typescript)
# VIVA_ECOSYSTEM=typescript
